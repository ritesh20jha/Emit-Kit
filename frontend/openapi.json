  "info": {
    "title": "EmitKit API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/lint": {
      "post": {
        "operationId": "lint",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LintRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LintIssue"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Lint a spec and return its issues",
        "tags": [
          "Lint"
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Get the signed-in user and their organizations",
        "tags": [
          "Me"
        ]
      }
    },
    "/me/sync-orgs": {
      "post": {
        "operationId": "syncOrgs",
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "summary": "Re-sync the signed-in user's organizations from the VCS provider",
        "tags": [
          "Me"
        ]
      }
    },
    "/me/vcs-quota": {
      "get": {
        "operationId": "vcsQuota",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuotaResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Get the signed-in user's remaining VCS API quota",
        "tags": [
          "Me"
        ]
      }
    },
    "/orgs": {
      "get": {
        "operationId": "listOrgs",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/OrgSummary"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "List the organizations the signed-in user belongs to",
        "tags": [
          "Orgs"
        ]
      }
    },
    "/orgs/{orgId}": {
      "get": {
        "operationId": "getOrg",
        "parameters": [
          {
            "in": "path",
            "name": "orgId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrgDetail"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Get one organization",
        "tags": [
          "Orgs"
        ]
      }
    },
    "/orgs/{orgId}/members": {
      "get": {
        "operationId": "listMembers",
        "parameters": [
          {
            "in": "path",
            "name": "orgId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MemberResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "List the members of an organization",
        "tags": [
          "Members"
        ]
      }
    },
    "/orgs/{orgId}/members/{userId}": {
      "patch": {
        "operationId": "updateMemberRole",
        "parameters": [
          {
            "in": "path",
            "name": "orgId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "userId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
