# Copy to deploy/compose/.env.prod (git-ignored) and fill in every empty value before the first start.
# Compose refuses to start with an empty secret (the ${VAR:?} guards in docker-compose.prod.yml).
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.prod ...

# Non-secret settings. Samples are fine to keep.
EMITKIT_SITE_ADDRESS=emitkit.example.com
EMITKIT_IMAGE_TAG=local
POSTGRES_DB=emitkit
POSTGRES_USER=emitkit
RABBITMQ_USER=emitkit
S3_BUCKET=emitkit-artifacts
# Numeric GID of the host group that owns /run/emitkit-sandbox/docker.sock (getent group emitkit-sandbox).
SANDBOX_GID=10010
# Container memory limits for the JVM services (api runs 2 replicas, worker 2). Size them per the runbook.
API_MEMORY_LIMIT=1g
WORKER_MEMORY_LIMIT=1536m
API_VAULT_SECRET_ID_FILE=./secrets/api-secret-id
WORKER_VAULT_SECRET_ID_FILE=./secrets/worker-secret-id

# Secrets. Empty on purpose: fill each one in. Generate passwords and keys with: openssl rand -base64 32
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# AppRole role IDs (printed by vault read in the runbook, step 6).
API_VAULT_ROLE_ID=
WORKER_VAULT_ROLE_ID=
