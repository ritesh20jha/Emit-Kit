# Copy to deploy/compose/.env.prod (git-ignored) and replace every CHANGE_ME value before the first start.
# Compose reads it with: docker compose -f docker-compose.prod.yml --env-file .env.prod ...

# Public host name Caddy serves and requests a certificate for.
EMITKIT_SITE_ADDRESS=emitkit.example.com

# Image tag for the locally built images (api, worker, web).
EMITKIT_IMAGE_TAG=local

POSTGRES_DB=emitkit
POSTGRES_USER=emitkit
POSTGRES_PASSWORD=CHANGE_ME
RABBITMQ_USER=emitkit
RABBITMQ_PASSWORD=CHANGE_ME
RUSTFS_ACCESS_KEY=CHANGE_ME
RUSTFS_SECRET_KEY=CHANGE_ME
S3_BUCKET=emitkit-artifacts

# GitHub OAuth app used for sign-in.
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME

# AppRole role IDs (not secret). Printed by `vault read -field=role_id auth/approle/role/<name>/role-id`.
API_VAULT_ROLE_ID=CHANGE_ME
WORKER_VAULT_ROLE_ID=CHANGE_ME

# Host files holding the AppRole secret IDs, mounted as Docker secrets. Keep them out of git.
API_VAULT_SECRET_ID_FILE=./secrets/api-secret-id
WORKER_VAULT_SECRET_ID_FILE=./secrets/worker-secret-id

# Numeric GID of the host group that owns /run/emitkit-sandbox/docker.sock (getent group emitkit-sandbox).
SANDBOX_GID=10010
