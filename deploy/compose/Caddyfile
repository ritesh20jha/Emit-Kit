# Edge proxy. EMITKIT_SITE_ADDRESS is the public host name (Caddy gets its certificate from ACME).
# EMITKIT_TLS_DIRECTIVE is empty in production (automatic ACME). The smoke overlay sets it to "tls internal".
{
	admin off
}

# Upstreams are the api replicas from Docker DNS (dynamic a). Caddy's active health checks do not run for
# dynamic upstreams, so health is passive: a replica that refuses a connection or does not send headers
# within 5 s is skipped for 30 s, and the request is retried on the other replica.
(upstream) {
	dynamic a api 8080 {
		refresh 10s
	}
	lb_policy round_robin
	lb_try_duration 15s
	lb_try_interval 250ms
	fail_duration 30s
	max_fails 1
	unhealthy_status 5xx
	transport http {
		dial_timeout 2s
		response_header_timeout 5s
	}
}

{$EMITKIT_SITE_ADDRESS} {
	{$EMITKIT_TLS_DIRECTIVE}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "default-src 'self'"
	}

	@sse path_regexp sse ^/api/v1/runs/[^/]+/logs/stream$
	@api path /api/* /oauth2/* /login/* /webhooks/*

	# SSE must not be buffered by the proxy. Listed first because @sse is a subset of @api.
	handle @sse {
		reverse_proxy {
			import upstream
			flush_interval -1
		}
	}

	handle @api {
		reverse_proxy {
			import upstream
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
