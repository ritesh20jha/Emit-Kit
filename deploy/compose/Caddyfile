# Edge proxy. EMITKIT_SITE_ADDRESS is the public host name (Caddy gets its certificate from ACME).
# EMITKIT_TLS_DIRECTIVE is empty in production (automatic ACME). The smoke overlay sets it to "tls internal".
{
	admin off
}

# Upstreams are the api replicas from Docker DNS (dynamic a). Caddy's active health checks do not run for
# dynamic upstreams, so health is passive. A replica is skipped for fail_duration after max_fails failures,
# where a failure is a refused or failed connection or no response headers within 30 s (the transport timeout
# below). An application 5xx is not a failure, so a sealed Vault (503 on secret endpoints) cannot take replicas
# out of rotation. The request is retried on the other replica while lb_try_duration lasts. lb_try_duration is
# longer than the header timeout so that one hung replica still leaves time to retry. A request that was already
# sent is retried only for GET and HEAD (Caddy's default, stated here); a connection that never opened is always retried.
(upstream) {
	dynamic a api 8080 {
		refresh 10s
	}
	lb_policy round_robin
	lb_try_duration 35s
	lb_try_interval 250ms
	lb_retry_match method GET HEAD
	fail_duration 30s
	max_fails 1
}

{$EMITKIT_SITE_ADDRESS} {
	{$EMITKIT_TLS_DIRECTIVE}

	encode zstd gzip

	# Sonner and Radix inject inline styles (style-src 'unsafe-inline'); avatars are served from GitHub (img-src).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://avatars.githubusercontent.com; frame-ancestors 'none'"
	}

	@sse path_regexp sse ^/api/v1/runs/[^/]+/logs/stream$
	@api path /api/* /oauth2/* /login/* /webhooks/*

	# SSE must not be buffered by the proxy. Listed first because @sse is a subset of @api.
	handle @sse {
		reverse_proxy {
			import upstream
			flush_interval -1
			# No response-header timeout: the stream may send nothing until the first event.
			transport http {
				dial_timeout 2s
			}
		}
	}

	handle @api {
		reverse_proxy {
			import upstream
			transport http {
				dial_timeout 2s
				response_header_timeout 30s
			}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
