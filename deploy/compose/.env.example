# Copy to deploy/compose/.env (git-ignored) to override these local dev defaults.
POSTGRES_DB=emitkit
POSTGRES_USER=emitkit
POSTGRES_PASSWORD=emitkit
RABBITMQ_USER=emitkit
RABBITMQ_PASSWORD=emitkit
# RustFS credentials are a local dev choice (not from the ticket).
RUSTFS_ACCESS_KEY=emitkit
RUSTFS_SECRET_KEY=emitkit-secret
S3_BUCKET=emitkit-artifacts
VAULT_DEV_ROOT_TOKEN=dev-root
