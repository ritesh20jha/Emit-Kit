      "response": {"status": 200, "headers": {"Content-Type": "application/json"}, "body": "{\"ref\":\"refs/heads/{{request.pathSegments.[6]}}\",\"url\":\"{{request.baseUrl}}/repos/acme/billing-sdk/git/refs/heads/{{request.pathSegments.[6]}}\",\"object\":{\"sha\":\"2c3d4e5f60718293a4b5c6d7e8f901234567890a\",\"type\":\"commit\"}}"}
