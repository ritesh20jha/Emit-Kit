{
  "mappings": [
    {
      "name": "GET git ref heads/{branch}: every branch resolves to the fixture head (stateless)",
      "request": {"method": "GET", "urlPathPattern": "/repos/acme/billing-api/git/refs/heads/.+"},
      "response": {"status": 200, "headers": {"Content-Type": "application/json"}, "body": "{\"ref\":\"refs/heads/{{request.pathSegments.[6]}}\",\"url\":\"{{request.baseUrl}}/repos/acme/billing-api/git/refs/heads/{{request.pathSegments.[6]}}\",\"object\":{\"sha\":\"0a1b2c3d4e5f60718293a4b5c6d7e8f901234567\",\"type\":\"commit\"}}"}
    },
    {
      "name": "POST git/refs: create a branch or tag at the sent sha",
      "request": {"method": "POST", "urlPath": "/repos/acme/billing-api/git/refs"},
      "response": {"status": 201, "headers": {"Content-Type": "application/json"}, "body": "{\"ref\":\"{{jsonPath request.body '$.ref'}}\",\"url\":\"{{request.baseUrl}}/repos/acme/billing-api/git/{{jsonPath request.body '$.ref'}}\",\"object\":{\"sha\":\"{{jsonPath request.body '$.sha'}}\",\"type\":\"commit\"}}"}
    },
    {
      "name": "PATCH git/refs/heads/{branch}: move the branch to the sent sha",
      "request": {"method": "PATCH", "urlPathPattern": "/repos/acme/billing-api/git/refs/heads/.+"},
      "response": {"status": 200, "headers": {"Content-Type": "application/json"}, "body": "{\"ref\":\"refs/heads/{{request.pathSegments.[6]}}\",\"url\":\"{{request.baseUrl}}/repos/acme/billing-api/git/refs/heads/{{request.pathSegments.[6]}}\",\"object\":{\"sha\":\"{{jsonPath request.body '$.sha'}}\",\"type\":\"commit\"}}"}
    },
    {
      "name": "DELETE git/refs/heads/{branch}: 204",
      "request": {"method": "DELETE", "urlPathPattern": "/repos/acme/billing-api/git/refs/heads/.+"},
      "response": {"status": 204}
    },
    {
      "name": "GET git/trees/{sha}, with or without recursive=1: the fixture tree holding the spec file",
      "request": {"method": "GET", "urlPathPattern": "/repos/acme/billing-api/git/trees/.+"},
      "response": {"status": 200, "headers": {"Content-Type": "application/json"}, "body": "{\"sha\":\"9b8c7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c\",\"truncated\":false,\"tree\":[{\"path\":\"openapi/billing.yaml\",\"mode\":\"100644\",\"type\":\"blob\",\"sha\":\"1477316fd2c1468876564127fe9185f0f4a0f68f\",\"size\":189}]}"}
    },
    {
      "name": "POST git/trees: a new tree with a fresh sha",
      "request": {"method": "POST", "urlPath": "/repos/acme/billing-api/git/trees"},
      "response": {"status": 201, "headers": {"Content-Type": "application/json"}, "body": "{\"sha\":\"{{randomValue type='HEXADECIMAL' length=40}}\",\"truncated\":false,\"tree\":[]}"}
    },
    {
      "name": "POST git/commits: a new commit whose html_url names its sha",
      "request": {"method": "POST", "urlPath": "/repos/acme/billing-api/git/commits"},
      "response": {"status": 201, "headers": {"Content-Type": "application/json"}, "body": "{{#assign 'sha'}}{{randomValue type='HEXADECIMAL' length=40}}{{/assign}}{\"sha\":\"{{sha}}\",\"url\":\"{{request.baseUrl}}/repos/acme/billing-api/git/commits/{{sha}}\",\"html_url\":\"https://github.com/acme/billing-api/commit/{{sha}}\",\"tree\":{\"sha\":\"{{jsonPath request.body '$.tree'}}\"}}"}
    },
    {
      "name": "GET issues/{n}: the pull request the comment is for",
      "request": {"method": "GET", "urlPathPattern": "/repos/acme/billing-api/issues/[0-9]+"},
      "response": {"status": 200, "headers": {"Content-Type": "application/json"}, "body": "{\"number\":{{request.pathSegments.[4]}},\"state\":\"open\",\"url\":\"{{request.baseUrl}}/repos/acme/billing-api/issues/{{request.pathSegments.[4]}}\",\"html_url\":\"https://github.com/acme/billing-api/pull/{{request.pathSegments.[4]}}\"}"}
    },
    {
      "name": "POST issues/{n}/comments: a comment with a fresh id",
      "request": {"method": "POST", "urlPathPattern": "/repos/acme/billing-api/issues/[0-9]+/comments"},
      "response": {"status": 201, "headers": {"Content-Type": "application/json"}, "body": "{\"id\":{{randomValue type='NUMERIC' length=9}},\"html_url\":\"https://github.com/acme/billing-api/pull/{{request.pathSegments.[4]}}#issuecomment-1\"}"}
    },
    {
      "name": "POST pulls: open a pull request; stateless, so every PR is number 1",
      "request": {"method": "POST", "urlPath": "/repos/acme/billing-api/pulls"},
      "response": {"status": 201, "headers": {"Content-Type": "application/json"}, "body": "{\"number\":1,\"state\":\"open\",\"url\":\"{{request.baseUrl}}/repos/acme/billing-api/pulls/1\",\"html_url\":\"https://github.com/acme/billing-api/pull/1\",\"head\":{\"ref\":\"{{jsonPath request.body '$.head'}}\",\"sha\":\"0a1b2c3d4e5f60718293a4b5c6d7e8f901234567\"},\"base\":{\"ref\":\"{{jsonPath request.body '$.base'}}\"}}"}
    }
  ]
}
