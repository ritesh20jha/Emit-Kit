<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%level %logger{0} - %msg%n</pattern>
    </encoder>
  </appender>
  <!-- The failure-path tests log WARNs on purpose; only errors reach the console. -->
  <root level="ERROR">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
