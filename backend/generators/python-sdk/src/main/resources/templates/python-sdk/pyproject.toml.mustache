[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = {{{packageNameLiteral}}}
version = {{{versionLiteral}}}
description = {{{descriptionLiteral}}}
readme = "README.md"
requires-python = ">=3.9"
dependencies = [
    "httpx>=0.27",
    "pydantic>=2.8",
]

[tool.hatch.build.targets.wheel]
packages = ["{{packageDir}}"]
