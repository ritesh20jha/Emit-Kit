    return error_type(status, _read_body(response), response.headers)


def _read_body(response: httpx.Response) -> Any:
    """Parses the body as JSON when it is JSON, otherwise returns the raw text."""
    text = response.text
    if text == "":
        return None
    try:
        return json.loads(text)
    except ValueError:
        return text
