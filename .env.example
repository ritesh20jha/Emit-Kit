# Local dev settings for the API and worker. Copy to .env (git-ignored), fill in the empty values, then load it:
#   set -a; source .env; set +a
# Spring Boot does not read .env itself. `source` cannot run $(cat ...), so paste the role IDs as literal values.
# Vault dev mode resets when its container restarts; refresh the role IDs after that.

# ---- GitHub OAuth app (required, API only; startup fails without them) ----
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_CLIENT_SECRET=

# ---- Public URL GitHub can reach (webhooks go to {url}/webhooks/github) ----
# Set this to your tunnel URL for real webhooks.
EMITKIT_PUBLIC_URL=http://localhost:8080

# ---- Vault (dev stack) ----
# Role IDs: cat deploy/compose/.secrets/api-role-id and worker-role-id
# Secret ID files: use absolute paths to deploy/compose/.secrets/
EMITKIT_VAULT_URI=http://localhost:8200
API_VAULT_ROLE_ID=
API_VAULT_SECRET_ID_FILE=/path/to/Emit-Kit/deploy/compose/.secrets/api-secret-id
WORKER_VAULT_ROLE_ID=
WORKER_VAULT_SECRET_ID_FILE=/path/to/Emit-Kit/deploy/compose/.secrets/worker-secret-id

# ---- Dependencies (these are the defaults; only needed to override) ----
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/emitkit
SPRING_DATASOURCE_USERNAME=emitkit
SPRING_DATASOURCE_PASSWORD=emitkit
SPRING_RABBITMQ_USERNAME=emitkit
SPRING_RABBITMQ_PASSWORD=emitkit
EMITKIT_STORAGE_ENDPOINT=http://localhost:9000
EMITKIT_STORAGE_BUCKET=emitkit-artifacts
EMITKIT_STORAGE_ACCESS_KEY=emitkit
EMITKIT_STORAGE_SECRET_KEY=emitkit-secret

# ---- Worker only ----
# Without the pipeline flag the worker consumes no jobs.
EMITKIT_WORKER_PIPELINE_ENABLED=true
EMITKIT_SANDBOX_DOCKER_HOST=unix:///run/emitkit-sandbox/docker.sock
# runc (default) or runsc, when gVisor is registered on the sandbox daemon.
EMITKIT_SANDBOX_RUNTIME=runc
# The default image is emitkit/toolchain:1.
EMITKIT_SANDBOX_IMAGE=emitkit/toolchain:test
# Only to point the worker and API at a mock instead of GitHub.
# EMITKIT_GITHUB_API_URL=https://api.github.com

# ---- Start commands (from the repo root, after loading this file) ----
# API:
#   cd backend && EMITKIT_VAULT_ROLEID=$API_VAULT_ROLE_ID EMITKIT_VAULT_SECRETIDFILE=$API_VAULT_SECRET_ID_FILE ./gradlew :api-app:bootRun
# Worker:
#   cd backend && EMITKIT_VAULT_ROLEID=$WORKER_VAULT_ROLE_ID EMITKIT_VAULT_SECRETIDFILE=$WORKER_VAULT_SECRET_ID_FILE ./gradlew :worker-app:bootRun
